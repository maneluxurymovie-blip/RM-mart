# GEMINI_API_KEY: Required for server-side Gemini AI customer support calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Store Owner Configuration (Verified Google Account Email for Admin Access)
VITE_OWNER_EMAIL="owner@example.com"
OWNER_EMAIL="owner@example.com"

# UPI Merchant Configuration (Placeholder — configure before accepting live UPI payments)
VITE_UPI_MERCHANT_VPA="rmmart@upi"
VITE_UPI_MERCHANT_NAME="RM Mart"
VITE_UPI_PROVIDER_VERIFIED="false"

# Optional Firebase Overrides (Primary config is loaded from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
